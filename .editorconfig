# Reglas mínimas de formato que respeta cualquier editor, más allá de lo que ya
# aplica el formateador del lenguaje — cubre archivos que ese formateador no toca.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{java,py}]
indent_size = 4 # convención estándar de Java/Python; el resto del repo usa 2

[*.md]
# En Markdown dos espacios al final de una línea fuerzan un salto de línea
# visible — "limpiar" ese espacio en automático rompería el formato del texto.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf # scripts de Windows; necesitan CRLF real para ejecutarse
